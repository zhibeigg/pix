FROM docker:29.7.2-cli AS docker_cli

FROM python:3.12.10-slim-bookworm

ARG GH_VERSION=2.67.0
ARG GH_LINUX_AMD64_SHA256=d77623479bec017ef8eebadfefc785bafd4658343b3eb6d3f3e26fd5e11368d5
ARG FASTAPI_VERSION=0.139.0
ARG HTTPX_VERSION=0.28.1
ARG PYDANTIC_VERSION=2.13.4
ARG PYDANTIC_SETTINGS_VERSION=2.12.0
ARG UVICORN_VERSION=0.51.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl postgresql-client \
    && curl --fail --location --silent --show-error \
        --output /tmp/gh.tar.gz \
        "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
    && echo "${GH_LINUX_AMD64_SHA256}  /tmp/gh.tar.gz" | sha256sum --check --strict \
    && tar -xzf /tmp/gh.tar.gz -C /tmp \
    && install -m 0755 "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
    && rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_amd64" /var/lib/apt/lists/* \
    && groupadd --gid 999 docker \
    && groupadd --gid 10001 pix-updater \
    && useradd --create-home --uid 10001 --gid pix-updater --groups docker pix-updater \
    && mkdir -p /app /var/lib/pix-updater/state /var/lib/pix-updater/backups /var/lib/pix-updater/logs \
    && chown -R pix-updater:10001 /app /var/lib/pix-updater

COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

RUN pip install --no-cache-dir \
    "fastapi==${FASTAPI_VERSION}" \
    "httpx==${HTTPX_VERSION}" \
    "pydantic==${PYDANTIC_VERSION}" \
    "pydantic-settings==${PYDANTIC_SETTINGS_VERSION}" \
    "uvicorn==${UVICORN_VERSION}"

WORKDIR /app
COPY --chown=pix-updater:10001 src/pix_updater ./src/pix_updater
COPY --chown=pix-updater:10001 src/pix/__init__.py ./src/pix/__init__.py

USER pix-updater
STOPSIGNAL SIGTERM

CMD ["python", "-m", "pix_updater.cli", "--host", "0.0.0.0", "--port", "8090"]
