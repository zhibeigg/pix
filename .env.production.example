# Copy this file to .env.production and replace all secrets before deploying.

PACKY_API_KEY=sk-xxxxxxxxxxxxxxxx
PACKY_VL_API_KEY=
PACKY_BASE_URL=https://www.packyapi.com

POSTGRES_USER=pix
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=pix

PIX_WEB_JWT_SECRET=change-this-to-a-long-random-secret
PIX_WEB_STORAGE_ROOT=web_outputs
PIX_WEB_MAX_UPLOAD_BYTES=10485760
PIX_WEB_AUTO_CREATE_DB=false
PIX_WEB_QUEUE_BACKEND=rq
PIX_WEB_REDIS_URL=redis://redis:6379/0
PIX_WEB_RQ_QUEUE=pix-jobs
PIX_WEB_RQ_WORKER_CLASS=default
PIX_WEB_PIX_CONFIG=
PIX_WEB_PUBLIC_BASE_URL=https://your-domain.com/api

# Alipay computer website payment
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# WeChat Pay API v3 Native payment
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_PRIVATE_KEY=
WECHATPAY_MERCHANT_SERIAL_NO=
WECHATPAY_API_V3_KEY=
WECHATPAY_PLATFORM_CERT=
WECHATPAY_API_BASE=https://api.mch.weixin.qq.com
