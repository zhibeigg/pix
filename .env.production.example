# Pix Web production example configuration
# Copy to .env.production and replace every placeholder before deployment.

POSTGRES_USER=pix
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=pix

# 生图供应商 Key：首次启动导入数据库做种子，之后以管理后台「上游供应商」为准（改这里不再影响已种子供应商，除非清空 image_providers 表）。
CRAZYROUTER_API_KEY=sk-your-crazyrouter-key
CRAZYROUTER_BASE_URL=https://crazyrouter.com
PIX_IMAGE_DEFAULT_MODEL=image2
PIX_IMAGE_PROVIDERS_JSON=
# 胜算云（ShengSuanYun）：异步任务协议上游，承载 image2（上游 openai/gpt-image-2，provider priority 第二）
SHENGSUANYUN_API_KEY=sk-your-shengsuanyun-key
SHENGSUANYUN_BASE_URL=https://router.shengsuanyun.com
# 火山方舟 Ark / Seedance：用于 sprite.mode="video_bridge" 首尾帧视频补间，默认关闭；也可在后台「视频补间」配置。
ARK_API_KEY=
VOLCENGINE_ARK_API_KEY=
PIX_VIDEO_BRIDGE_ENABLED=false
PIX_VIDEO_BRIDGE_MODEL=doubao-seedance-2-0-260128
PIX_VIDEO_BRIDGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 旧版视频秒数兜底值；video_bridge 新任务实际按 rows×cols×duration_ms 推导 Ark 秒数。
PIX_VIDEO_BRIDGE_DURATION=5
# Packy 旧变量：仅用于老部署首次升级时导入「上游供应商」种子 / fallback。
# 新部署请优先在后台「上游供应商」配置；后台「模型与 API」不再展示这些旧入口。
PACKY_API_KEY=sk-your-packy-image-key
PACKY_VL_API_KEY=sk-your-packy-vision-key
PACKY_BASE_URL=https://www.packyapi.com
PIX_WEB_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# 运行环境：生产务必设为 prod —— 此时若 JWT secret 仍为默认值、长度不足 32 或 Cookie 未启用 Secure，服务会拒绝启动。
PIX_WEB_ENV=prod
# 浏览器会话仅通过 HttpOnly Cookie 保存。跨站（非同站）前后端部署改为 SameSite=none，并保持 Secure=true。
PIX_WEB_SESSION_COOKIE_SECURE=true
PIX_WEB_SESSION_COOKIE_SAMESITE=lax
PIX_WEB_PUBLIC_BASE_URL=https://your-domain.com/api
# Announcement email buttons use this frontend URL first. Leave empty only when it can be derived from PUBLIC_BASE_URL.
PIX_WEB_FRONTEND_BASE_URL=https://your-domain.com
# Same-origin /api reverse proxy can leave this empty. Set when the frontend and API are on different origins.
PIX_WEB_CORS_ORIGINS=
PIX_WEB_STORAGE_ROOT=web_outputs
PIX_WEB_MAX_UPLOAD_BYTES=10485760
PIX_WEB_AUTO_CREATE_DB=false
# 接口限流（登录/验证码等）总开关，默认开启。反向代理需正确透传 X-Forwarded-For 以按真实客户端 IP 限流。
PIX_WEB_RATE_LIMIT_ENABLED=true
# SSRF 防护：默认禁止服务端下载指向内网/回环/云元数据地址的 URL。
# 仅当上游生图/视频供应商部署在可信内网、确需放行时才设为 true。
PIX_ALLOW_PRIVATE_DOWNLOAD=false
PIX_WEB_QUEUE_BACKEND=rq
PIX_WEB_WORKER_CONCURRENCY=3
PIX_WEB_RUNNING_JOB_TIMEOUT_MINUTES=60
PIX_WEB_RUNNING_JOB_CLEANUP_INTERVAL_SECONDS=60
PIX_WEB_REDIS_URL=redis://redis:6379/0
PIX_WEB_RQ_QUEUE=pix-jobs
PIX_WEB_RQ_WORKER_CLASS=default
PIX_WEB_PIX_CONFIG=

# Email verification for registration
PIX_WEB_EMAIL_PROVIDER=smtp
PIX_WEB_SMTP_HOST=smtp.example.com
PIX_WEB_SMTP_PORT=587
PIX_WEB_SMTP_USER=noreply@example.com
PIX_WEB_SMTP_PASSWORD=change-me-smtp-password
PIX_WEB_SMTP_FROM="Pix <noreply@example.com>"
PIX_WEB_SMTP_TLS=true
PIX_WEB_EMAIL_CODE_TTL_SECONDS=600
PIX_WEB_EMAIL_CODE_RESEND_SECONDS=60
PIX_WEB_EMAIL_CODE_MAX_ATTEMPTS=5
PIX_WEB_EMAIL_DEBUG_CODES=false

# Cloudflare Turnstile adaptive anti-abuse for email-code endpoints.
# Normal users do not see it; only repeated requests from the same email/IP require a challenge.
# Create a Turnstile site at https://dash.cloudflare.com/?to=/:account/turnstile and paste keys here.
PIX_WEB_TURNSTILE_ENABLED=true
PIX_WEB_TURNSTILE_SITE_KEY=
PIX_WEB_TURNSTILE_SECRET_KEY=
PIX_WEB_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
PIX_WEB_TURNSTILE_EMAIL_WINDOW_SECONDS=3600
PIX_WEB_TURNSTILE_EMAIL_MAX_WITHOUT_CHALLENGE=2
PIX_WEB_TURNSTILE_IP_WINDOW_SECONDS=3600
PIX_WEB_TURNSTILE_IP_MAX_WITHOUT_CHALLENGE=5

# Optional China payment providers
# Alipay uses the official alipay-sdk-python SDK. Use public key mode here, or deploy/*.env.production.example for certificate mode.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_PRIVATE_KEY=
WECHATPAY_MERCHANT_SERIAL_NO=
WECHATPAY_API_V3_KEY=
WECHATPAY_PLATFORM_CERT=
WECHATPAY_API_BASE=https://api.mch.weixin.qq.com

# 后台版本检测与执行开关。检测默认开启；完成 updater bootstrap、备份与回滚演练前保持 APPLY=false。
PIX_WEB_UPDATE_CHECK_ENABLED=true
PIX_WEB_UPDATE_APPLY_ENABLED=false
PIX_WEB_UPDATE_REPOSITORY=zhibeigg/pix
PIX_WEB_UPDATE_CHANNEL=stable
PIX_WEB_UPDATE_GITHUB_API_BASE=https://api.github.com
PIX_WEB_UPDATE_TIMEOUT_SECONDS=5
PIX_WEB_UPDATE_CACHE_TTL_SECONDS=300
PIX_WEB_UPDATE_STEP_UP_TTL_SECONDS=300
# Web API -> Pix Update Agent（仅 Compose 内网；不要把 updater 端口发布到公网）。
PIX_WEB_UPDATE_AGENT_URL=http://updater:8090
PIX_WEB_UPDATE_AGENT_TOKEN_FILE=/run/secrets/pix_updater_token

# Agent 默认安全关闭。首次 bootstrap 完成 token、release.env、目录权限及 Docker socket 组后再启用。
PIX_UPDATER_ENABLED=false
PIX_UPDATER_REPOSITORY=zhibeigg/pix
PIX_UPDATER_BACKEND_IMAGE=ghcr.io/zhibeigg/pix-backend
PIX_UPDATER_FRONTEND_IMAGE=ghcr.io/zhibeigg/pix-web
PIX_UPDATER_UPDATER_IMAGE=ghcr.io/zhibeigg/pix-updater
PIX_UPDATER_COMPOSE_PROJECT=pix
PIX_UPDATER_BACKUP_RETENTION=5
PIX_UPDATER_LOG_RETENTION=20
PIX_DEPLOYMENT_ROOT=.
PIX_UPDATER_STATE_HOST_DIR=./updater-state
PIX_UPDATER_BACKUP_HOST_DIR=./updater-backups
PIX_UPDATER_LOG_HOST_DIR=./updater-logs
PIX_UPDATER_TOKEN_HOST_FILE=./pix-updater.token
DOCKER_GID=999
