# 各家生图供应商 API Key。首次启动时这些值会连同 config.toml 的 [[image_providers]] 一起导入数据库做种子；
# 之后以管理后台「上游供应商」为准（改这里不再影响已种子的供应商，除非清空 image_providers 表）。
# Crazyrouter API key（推荐；支持多种生图协议/模型，Pix 会按 provider priority 自动失败切换）
CRAZYROUTER_API_KEY=
CRAZYROUTER_BASE_URL=https://crazyrouter.com
# 默认生图 logical model；可被 config.toml / 管理后台覆盖
PIX_IMAGE_DEFAULT_MODEL=image2
# 可选：用 JSON 覆盖/补充 image_providers，适合容器密钥管理场景
PIX_IMAGE_PROVIDERS_JSON=

# 胜算云（ShengSuanYun）API key：异步任务协议上游，承载 image2（上游 openai/gpt-image-2）
# provider priority 第二（介于 packy 与 crazyrouter 之间）；填入后会自动注入为生图 Provider
SHENGSUANYUN_API_KEY=
SHENGSUANYUN_BASE_URL=https://router.shengsuanyun.com

# Packy 旧变量：仅用于老部署首次升级时导入「上游供应商」种子 / fallback。
# 新部署请优先在后台「上游供应商」配置；后台「模型与 API」不再展示这些旧入口。
PACKY_API_KEY=sk-xxxxxxxxxxxxxxxx

# 视觉模型旧变量：老部署兼容 / 首次导入用；可与 PACKY_API_KEY 共用。
PACKY_VL_API_KEY=

# Gemini 生图旧变量：老部署兼容 / 首次导入用；留空时自动回退 PACKY_API_KEY。
PACKY_GEMINI_API_KEY=

# Packy 旧 Base URL：老部署兼容 / 首次导入用，一般无需修改。
PACKY_BASE_URL=https://www.packyapi.com

# Web 后端配置（网站版 MVP）
PIX_WEB_DATABASE_URL=sqlite:///pix_web.db
PIX_WEB_JWT_SECRET=change-me-to-a-long-random-secret
PIX_WEB_STORAGE_ROOT=web_outputs
PIX_WEB_MAX_UPLOAD_BYTES=10485760
PIX_WEB_AUTO_CREATE_DB=true
PIX_WEB_QUEUE_BACKEND=database
PIX_WEB_WORKER_CONCURRENCY=3
# running 任务超过该分钟数会被 worker 自动标记失败并退款
PIX_WEB_RUNNING_JOB_TIMEOUT_MINUTES=60
# worker 扫描超时 running 任务的间隔（秒）
PIX_WEB_RUNNING_JOB_CLEANUP_INTERVAL_SECONDS=60
PIX_WEB_REDIS_URL=redis://localhost:6379/0
PIX_WEB_RQ_QUEUE=pix-jobs
PIX_WEB_RQ_WORKER_CLASS=simple
# 对外 API 与前端地址；公告邮件按钮优先使用 PIX_WEB_FRONTEND_BASE_URL，留空时会从 PUBLIC_BASE_URL 推导。
PIX_WEB_PUBLIC_BASE_URL=http://127.0.0.1:8000
PIX_WEB_FRONTEND_BASE_URL=http://127.0.0.1:5173
# 前后端分离部署时填写允许访问 API 的前端 Origin，多个用英文逗号分隔；Docker/Nginx 默认走同源 /api 代理可留空。
PIX_WEB_CORS_ORIGINS=
# 注册邮箱验证码：开发默认 console，生产建议 smtp
PIX_WEB_EMAIL_PROVIDER=console
PIX_WEB_SMTP_HOST=
PIX_WEB_SMTP_PORT=587
PIX_WEB_SMTP_USER=
PIX_WEB_SMTP_PASSWORD=
PIX_WEB_SMTP_FROM=
PIX_WEB_SMTP_TLS=true
PIX_WEB_EMAIL_CODE_TTL_SECONDS=600
PIX_WEB_EMAIL_CODE_RESEND_SECONDS=60
PIX_WEB_EMAIL_CODE_MAX_ATTEMPTS=5
PIX_WEB_EMAIL_DEBUG_CODES=false
# Cloudflare Turnstile 人机校验：启用后只在同邮箱/同 IP 频繁请求验证码时触发
# 开关默认关闭；启用前先到 Cloudflare 控制台创建 Turnstile 站点并填上 site/secret key
PIX_WEB_TURNSTILE_ENABLED=false
PIX_WEB_TURNSTILE_SITE_KEY=
PIX_WEB_TURNSTILE_SECRET_KEY=
# 校验地址，默认 Cloudflare 公共 endpoint，无特殊需求保持默认
PIX_WEB_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
PIX_WEB_TURNSTILE_EMAIL_WINDOW_SECONDS=3600
PIX_WEB_TURNSTILE_EMAIL_MAX_WITHOUT_CHALLENGE=2
PIX_WEB_TURNSTILE_IP_WINDOW_SECONDS=3600
PIX_WEB_TURNSTILE_IP_MAX_WITHOUT_CHALLENGE=5
# 可选：让 Web worker 使用指定 pix config.toml
PIX_WEB_PIX_CONFIG=
