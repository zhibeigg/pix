# Pix 后端生产环境变量模板
# 复制为 deploy/.env.production 后，把所有 change-me / your-domain 占位值替换掉。

POSTGRES_USER=pix
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=pix

# 宿主机暴露的 API 端口。若前面有 Nginx/Caddy，可只监听 127.0.0.1 防火墙层面限制访问。
PIX_WEB_API_PORT=8000

# Packy / OpenAI 兼容接口
PACKY_API_KEY=sk-your-packy-image-key
PACKY_VL_API_KEY=sk-your-packy-vision-key
PACKY_BASE_URL=https://www.packyapi.com

# Web 后端安全配置
PIX_WEB_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
PIX_WEB_PUBLIC_BASE_URL=https://api.your-domain.com
# 前后端分离部署时填写前端 Origin，多个用英文逗号分隔，例如：https://your-domain.com,https://www.your-domain.com
PIX_WEB_CORS_ORIGINS=

# 存储与队列
PIX_WEB_STORAGE_ROOT=web_outputs
PIX_WEB_MAX_UPLOAD_BYTES=10485760
PIX_WEB_AUTO_CREATE_DB=false
PIX_WEB_QUEUE_BACKEND=rq
PIX_WEB_REDIS_URL=redis://redis:6379/0
PIX_WEB_RQ_QUEUE=pix-jobs
PIX_WEB_RQ_WORKER_CLASS=default
# 可选：让 worker 使用指定 config.toml；容器内路径通常需要额外挂载。
PIX_WEB_PIX_CONFIG=

# 邮箱验证码：生产建议 smtp；内测可临时用 console。
# 465 端口使用 implicit SSL；若使用 587 STARTTLS，请改为 PIX_WEB_SMTP_PORT=587、PIX_WEB_SMTP_SSL=false、PIX_WEB_SMTP_TLS=true。
PIX_WEB_EMAIL_PROVIDER=smtp
PIX_WEB_SMTP_HOST=smtp.example.com
PIX_WEB_SMTP_PORT=465
PIX_WEB_SMTP_USER=noreply@example.com
PIX_WEB_SMTP_PASSWORD=change-me-smtp-password
PIX_WEB_SMTP_FROM="Pix <noreply@example.com>"
PIX_WEB_SMTP_SSL=true
PIX_WEB_SMTP_TLS=false
PIX_WEB_EMAIL_CODE_TTL_SECONDS=600
PIX_WEB_EMAIL_CODE_RESEND_SECONDS=60
PIX_WEB_EMAIL_CODE_MAX_ATTEMPTS=5
PIX_WEB_EMAIL_DEBUG_CODES=false

# 可选：中国支付渠道；不用真实支付可留空，系统可使用 mock pay。
# 支付宝接入官方 alipay-sdk-python；支持 public_key 公钥模式和 certificate 证书模式；auto 会在检测到证书配置时自动走证书模式。
ALIPAY_MODE=auto
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
# 公钥模式验签使用：
ALIPAY_PUBLIC_KEY=
# 证书模式使用 PEM 内容或文件路径；推荐用 *_PATH 指向 Secret 挂载文件。
ALIPAY_APP_CERT=
ALIPAY_PUBLIC_CERT=
ALIPAY_ROOT_CERT=
ALIPAY_APP_CERT_PATH=
ALIPAY_PUBLIC_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_PRIVATE_KEY=
WECHATPAY_MERCHANT_SERIAL_NO=
WECHATPAY_API_V3_KEY=
WECHATPAY_PLATFORM_CERT=
WECHATPAY_API_BASE=https://api.mch.weixin.qq.com
